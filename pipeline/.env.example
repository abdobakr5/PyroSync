# Copy this file to .env and fill in the values. Never commit .env to Git.

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (only needed for --nrt)
FIRMS_MAP_KEY=your_map_key_here

# PostgreSQL + PostGIS (only needed for the publish stage)
DATABASE_URL=postgresql://user:password@localhost:5432/firms

# Optional: use a mirror or a local test server instead of the FIRMS country archive
# FIRMS_COUNTRY_BASE_URL=https://firms.modaps.eosdis.nasa.gov/data/country
